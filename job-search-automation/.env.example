# Optional. Bing RSS, DuckDuckGo, and Tavily's rate-limited keyless mode work without a key.
# A Tavily key improves the daily deep scan; auto mode caps Tavily at 12 queries per run.
TAVILY_API_KEY=

# Optional email notification settings. Passwords remain environment variables.
JOBFINDER_SMTP_HOST=
JOBFINDER_SMTP_PORT=587
JOBFINDER_SMTP_USER=
JOBFINDER_SMTP_PASSWORD=
JOBFINDER_SMTP_FROM=
JOBFINDER_EMAIL_TO=
JOBFINDER_SMTP_STARTTLS=true

# Optional Telegram notification settings.
JOBFINDER_TELEGRAM_BOT_TOKEN=
JOBFINDER_TELEGRAM_CHAT_ID=
